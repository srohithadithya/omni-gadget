# AIDE-OS Backend — Environment Configuration
# Copy this file to .env and fill in your values

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://aideuser:aidepass@localhost:5432/aideosdb

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
