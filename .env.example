# ═══════════════════════════════════════════════════════════════════════════════
# AIDE-OS — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For Render deployment, set these as Environment Variables in the Dashboard.
# For local dev, keep docker-compose.yml defaults.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxx.us-east-2.aws.neon.tech/aideosdb?sslmode=require

# ── Cache (Upstash Redis) ────────────────────────────────────────────────────
# Format: rediss://<password>@<host>:6380
# Get from: https://console.upstash.com → Database → Connection Details
REDIS_URL=rediss://xxxx@xxx.upstash.io:6380

# ── Application ──────────────────────────────────────────────────────────────
# Secret key for session signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_CHAT_ID=

# ── Affiliate / E-Commerce ───────────────────────────────────────────────────
# Amazon Associates tag (format: yourtag-21)
AMAZON_AFFILIATE_TAG=
# Flipkart Affiliate ID (from https://affiliate.flipkart.com)
FLIPKIP_AFFILIATE_ID=

# ── CORS & Networking ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use ["*"] for development.
CORS_ORIGINS=["https://aide-os.vercel.app","http://localhost:3000"]

# Full backend URL (used by frontend for API calls)
BACKEND_URL=https://aide-os-api.onrender.com

# ── Debug (set to false in production) ───────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
